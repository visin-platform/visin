AUTH_SERVICE_URL=http://localhost:5001
AUTH_FRONT_URL=http://localhost:3004
ACCOUNT_FRONT_URL=http://localhost:3007
LABEL_FRONT_URL=http://localhost:3008
VISION_API_URL=http://localhost:4010

# Optional: this deployment's docs site (the landing site). Result explanations link to its guides when set, and
# never to anyone else's address when it is not.
LANDING_FRONT_URL=http://localhost:3000

# Optional: a Hugging Face mirror or enterprise Hub that model and dataset links open. Empty means the public Hub.
HF_ENDPOINT=
