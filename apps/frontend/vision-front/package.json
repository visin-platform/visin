{
  "name": "vision-front",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin-monorepo.git",
    "directory": "apps/frontend/vision-front"
  },
  "type": "module",
  "author": "Toomas Tahves",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
