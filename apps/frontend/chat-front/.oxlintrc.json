{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**"],
  "env": {
    "node": true,
    "es2025": true,
    "browser": true,
    "vitest": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/static-components": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "off",
    "react/error-boundaries": "off",
    "react/unsupported-syntax": "off",
    "react/jsx-key": "off",
    "typescript/no-namespace": [
      "error",
      {
        "allowDeclarations": true
      }
    ],
    "react/only-export-components": "error",
    "visin/no-color-literals": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/triple-slash-reference": "error",
    "no-array-constructor": "error",
    "no-unused-expressions": "error",
    "typescript/no-extra-non-null-assertion": "error"
  },
  "jsPlugins": [
    {
      "name": "visin",
      "specifier": "../../../scripts/oxlint-visin.mjs"
    }
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**/*.ts", "**/__tests__/**/*.tsx", "e2e/**/*.ts"],
      "rules": {
        "visin/no-color-literals": "off"
      }
    }
  ]
}
