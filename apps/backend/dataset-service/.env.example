PORT=5010
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/visin

# Must match JWT_SECRET in auth-service
JWT_SECRET=<change-me>

# Must match INTERNAL_SERVICE_TOKEN in auth-service/group-service/label-service
INTERNAL_SERVICE_TOKEN=<change-me>

GROUP_SERVICE_URL=http://localhost:5006

# file-service internal API (dataset zips + extracted images)
FILE_SERVICE_URL=http://localhost:5002
# Must match FILE_SERVICE_API_KEY in file-service
FILE_SERVICE_API_KEY=<change-me>

# Comma-separated list of allowed browser origins (vision-front, shell-front)
CORS_ORIGIN=http://localhost:3012,http://localhost:3010

# The MCP server OAuth access tokens are minted for
MCP_PUBLIC_URL=http://localhost:5009

# Redis backing the import queue
REDIS_URL=redis://localhost:6379

# Import tuning — defaults shown, all optional
# DATASET_IMPORT_CONCURRENCY=4
# DATASET_IMPORT_JOB_ATTEMPTS=3
# DATASET_IMPORT_JOB_BACKOFF_MS=5000
# DATASET_IMPORT_MAX_STALLED=2
# DATASET_IMPORT_MAX_ENTRIES=500000
# DATASET_IMPORT_MAX_ENTRY_BYTES=52428800
# DATASET_IMPORT_MAX_JSON_BYTES=1048576
