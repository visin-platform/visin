{
  "ActivityQuery": {
    "type": "object",
    "properties": {
      "user": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$"
      },
      "owner": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$"
      },
      "limit": {
        "default": 30,
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    }
  },
  "ArchiveUploadBody": {
    "type": "object",
    "properties": {
      "filename": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "size": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "lastModified": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "filename"
    ]
  },
  "CreateDatasetBody": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "maxLength": 10000
      },
      "owner": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "group"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          }
        },
        "required": [
          "kind",
          "id"
        ]
      },
      "visibility": {
        "type": "string",
        "enum": [
          "private",
          "public"
        ]
      },
      "source": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "const": "hf"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}\\/[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          },
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "repo",
          "revision"
        ]
      },
      "license": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "cc0-1.0",
                  "cc-by-4.0",
                  "cc-by-sa-4.0",
                  "cc-by-nd-4.0",
                  "cc-by-nc-4.0",
                  "cc-by-nc-sa-4.0",
                  "cc-by-nc-nd-4.0",
                  "cc-by-3.0",
                  "cc-by-sa-3.0",
                  "odc-by",
                  "odbl",
                  "pddl",
                  "cdla-permissive-2.0",
                  "cdla-sharing-1.0",
                  "apache-2.0",
                  "mit",
                  "bsd-2-clause",
                  "bsd-3-clause",
                  "gpl-3.0"
                ]
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "const": "other"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        ]
      },
      "credit": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "required": [
      "name"
    ]
  },
  "ListDatasetsQuery": {
    "type": "object",
    "properties": {
      "search": {
        "type": "string",
        "maxLength": 200
      },
      "owner": {
        "anyOf": [
          {
            "type": "string",
            "const": "me"
          },
          {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          }
        ]
      },
      "user": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$"
      },
      "visibility": {
        "type": "string",
        "const": "public"
      },
      "page": {
        "default": 1,
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "limit": {
        "default": 30,
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 100
      }
    }
  },
  "ListItemsQuery": {
    "type": "object",
    "properties": {
      "group": {
        "type": "string",
        "maxLength": 100
      },
      "kind": {
        "type": "string",
        "enum": [
          "image",
          "json"
        ]
      },
      "stem": {
        "type": "string",
        "maxLength": 500
      },
      "search": {
        "type": "string",
        "maxLength": 200
      },
      "page": {
        "default": 1,
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "limit": {
        "default": 60,
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 200
      }
    }
  },
  "SetCoverBody": {
    "type": "object",
    "properties": {
      "itemId": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "itemId"
    ]
  },
  "StartImportBody": {
    "type": "object",
    "properties": {
      "groups": {
        "minItems": 1,
        "maxItems": 500,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "maxLength": 1000
            },
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "folder",
            "group"
          ]
        }
      },
      "manifest": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "required": [
      "groups"
    ]
  },
  "TransferDatasetBody": {
    "type": "object",
    "properties": {
      "owner": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "group"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          }
        },
        "required": [
          "kind",
          "id"
        ]
      }
    },
    "required": [
      "owner"
    ]
  },
  "UpdateDatasetBody": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "maxLength": 10000
      },
      "visibility": {
        "type": "string",
        "enum": [
          "private",
          "public"
        ]
      },
      "source": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "hf"
              },
              "repo": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}\\/[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "provider",
              "repo",
              "revision"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "license": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "cc0-1.0",
                      "cc-by-4.0",
                      "cc-by-sa-4.0",
                      "cc-by-nd-4.0",
                      "cc-by-nc-4.0",
                      "cc-by-nc-sa-4.0",
                      "cc-by-nc-nd-4.0",
                      "cc-by-3.0",
                      "cc-by-sa-3.0",
                      "odc-by",
                      "odbl",
                      "pddl",
                      "cdla-permissive-2.0",
                      "cdla-sharing-1.0",
                      "apache-2.0",
                      "mit",
                      "bsd-2-clause",
                      "bsd-3-clause",
                      "gpl-3.0"
                    ]
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "const": "other"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "credit": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
