{
  "name": "file-service",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin.git",
    "directory": "apps/backend/file-service"
  },
  "author": "Toomas Tahves",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "nodemon --watch src --ext ts,json --exec \"node --env-file-if-exists=.env -r ts-node/register\" src/index.ts",
    "build": "tsc",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:coverage": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@visin/backend-core": "1.13.0",
    "express": "^5.2.1",
    "mongoose": "~9.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "mongodb-memory-server": "11.3.0"
  }
}
