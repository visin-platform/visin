{
  "compilerOptions": {
    // Node 26 runs ES2025 natively, so nothing is downleveled.
    "target": "ES2025",
    "lib": ["ES2025"],
    // TypeScript 6 no longer adds every @types package on its own.
    "types": ["node"],
    "module": "NodeNext",
    // Keep Node resolution explicit so package exports resolve consistently.
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "watchOptions": {
    "excludeDirectories": ["data", "node_modules", "dist"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
