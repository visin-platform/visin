{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "watchOptions": {
    "excludeDirectories": ["data", "node_modules", "dist"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/__tests__"]
}
