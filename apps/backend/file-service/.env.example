PORT=5002
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/visin

# Directory where files are stored (relative to CWD in dev, absolute in Docker)
FILE_SERVICE_DATA_DIR=./data

# File Service Configuration
FILE_SERVICE_URL=http://localhost:5002
FILE_SERVICE_API_KEY=<change-me>
FILE_SERVICE_HMAC_SECRET=<change-me>

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3004,http://localhost:3007,http://localhost:3012
