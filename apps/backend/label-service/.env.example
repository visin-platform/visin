PORT=5008
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/visin

# Must match JWT_SECRET in auth-service
JWT_SECRET=<change-me>

# Must match INTERNAL_SERVICE_TOKEN in auth-service/group-service
INTERNAL_SERVICE_TOKEN=<change-me>

GROUP_SERVICE_URL=http://localhost:5006

# file-service internal API (signing the image URLs a task shows)
FILE_SERVICE_URL=http://localhost:5002
# Optional: file-service's address on a private network, preferred over FILE_SERVICE_URL for
# this service's own calls (e.g. http://file-service:5002 when the public URL goes through a proxy).
FILE_SERVICE_INTERNAL_URL=
# Must match FILE_SERVICE_API_KEY in file-service
FILE_SERVICE_API_KEY=<change-me>

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3008

# dataset-service internal API (the datasets jobs are built on)
DATASET_SERVICE_URL=http://localhost:5010
