PORT=5008
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/visin

# Must match JWT_SECRET in auth-service
JWT_SECRET=<change-me>

# Must match INTERNAL_SERVICE_TOKEN in auth-service/group-service
INTERNAL_SERVICE_TOKEN=<change-me>

GROUP_SERVICE_URL=http://localhost:5006

# file-service internal API (bundle zip storage + image bytes)
FILE_SERVICE_URL=http://localhost:5002
# Must match FILE_SERVICE_API_KEY in file-service
FILE_SERVICE_API_KEY=<change-me>

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3008

# Redis backing the bundle-import queue (docker-compose.dev.yml provides it)
REDIS_URL=redis://localhost:6379

# Import queue tuning — defaults shown, all optional
# IMPORT_CONCURRENCY=1
# IMPORT_JOB_ATTEMPTS=3
# IMPORT_JOB_BACKOFF_MS=5000
# IMPORT_MAX_STALLED=2
