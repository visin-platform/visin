    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "11.2.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
