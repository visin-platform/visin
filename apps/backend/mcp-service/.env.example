# mcp-service — the MCP server assistants connect to.
#
# The server accepts user API keys and OAuth access tokens. It verifies keys
# against MongoDB, checks OAuth token signatures with JWT_SECRET, and calls
# vision-service and dataset-service for tool data.
#
# OAuth access tokens are verified with the same JWT_SECRET as auth-service.
# API_KEY_ENCRYPTION_SECRET is not needed: this service only verifies keys.

PORT=5009
MONGODB_URI=mongodb://localhost:27017/visin
JWT_SECRET=<change-me>

# Where tool calls go. The internal address is preferred when set.
VISION_SERVICE_URL=http://localhost:4010
VISION_INTERNAL_URL=
DATASET_SERVICE_URL=http://localhost:5010
DATASET_INTERNAL_URL=

# The canonical URL clients are told to connect and authenticate against. Ends
# up in the protected-resource metadata, so it must be the address clients
# actually reach.
MCP_PUBLIC_URL=http://localhost:5009

# Named in the protected-resource metadata as the OAuth issuer.
AUTH_SERVICE_URL=http://localhost:5001

# Standalone Compose reads these public fallback addresses. Replace localhost
# with browser-reachable HTTPS URLs for a separate-service deployment.
VISION_API_URL=http://localhost:4010
DATASET_API_URL=http://localhost:5010
