# mcp-service — the MCP server assistants connect to.
#
# This process holds no domain data. It verifies the API key a request arrives
# with (the only thing it needs Mongo for) and forwards that same key to
# vision-service for every read and write, so vision-service's own project
# privacy rules apply unchanged.
#
# Deliberately absent: JWT_SECRET (it never verifies a user session) and
# API_KEY_ENCRYPTION_SECRET (it never mints or reveals a key — verification runs
# off a SHA-256 digest and never touches the encrypted copy).

PORT=5009
MONGODB_URI=mongodb://localhost:27017/visin

# Where tool calls go. The internal address is preferred when set.
VISION_SERVICE_URL=http://localhost:4010
VISION_INTERNAL_URL=

# The canonical URL clients are told to connect and authenticate against. Ends
# up in the protected-resource metadata, so it must be the address clients
# actually reach.
MCP_PUBLIC_URL=http://localhost:5009

# Named in the protected-resource metadata as where a token will come from once
# OAuth exists. Not used to verify anything today.
AUTH_SERVICE_URL=http://localhost:5001
