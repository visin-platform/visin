{
  "name": "vision-service",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin.git",
    "directory": "apps/backend/vision-service"
  },
  "author": "Toomas Tahves",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --watch --env-file-if-exists=.env -r ts-node/register src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "docs:generate": "UPDATE_OPENAPI_SCHEMAS=1 vitest run src/__tests__/openapi"
  },
  "dependencies": {
    "@visin/backend-core": "1.18.0",
    "express": "^5.3.0",
    "mongoose": "~9.10.4",
    "unpdf": "1.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mongodb-memory-server": "11.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "oxlint": "^1.91.0",
    "vitest": "^5.1.0",
    "@vitest/coverage-istanbul": "^5.1.0"
  }
}
