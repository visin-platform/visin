  "CreateProjectBody": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "editorGroupIds": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        }
      },
      "isPublic": {
        "default": false,
        "type": "boolean"
      },
