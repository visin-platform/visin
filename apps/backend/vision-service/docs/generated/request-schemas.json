                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "order": {
                  "type": "integer"
                }
              },
              "required": [
                "key"
              ]
            }
          },
          "classes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "order": {
                  "type": "integer"
                }
              },
              "required": [
                "key"
              ]
            }
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "higher",
                    "lower"
                  ]
                },
                "decimals": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "number",
                    "percent",
                    "ms",
                    "fps"
                  ]
                }
              },
              "required": [
                "key"
              ]
            }
          },
          "overallMetrics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "taskType": {
            "type": "string",
            "enum": [
              "segmentation",
              "detection",
              "classification",
              "other"
            ]
          },
          "exportPathPrefix": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "costing": {
        "type": "object",
        "properties": {
          "cpuRatePerHour": {
            "type": "number",
            "minimum": 0
          },
          "gpuRatePerHour": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        }
      }
    },
    "required": [
      "name"
    ]
  },
