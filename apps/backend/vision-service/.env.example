PORT=4010
MONGODB_URI=
JWT_SECRET=<change-me>
CORS_ORIGIN=http://localhost:3000,http://localhost:3004,http://localhost:3007,http://localhost:3008,http://localhost:3010,http://localhost:3012
GROUP_SERVICE_URL=http://localhost:5006
DATASET_SERVICE_URL=http://localhost:5010

# Optional: told to clients by GET /api/.well-known/visin, so `visin login` needs only this service's address.
# The dataset service's and the web app's public addresses; unset, they are left out of the answer.
PUBLIC_DATASET_API_URL=http://localhost:5010
PUBLIC_APP_URL=http://localhost:3012
# Optional: this service's own public address, for the leaderboard badges a generated model card embeds. Unset, the
# card links the leaderboard page (when PUBLIC_APP_URL is set) and shows no badge image.
VISION_API_URL=
# File Service Configuration
FILE_SERVICE_URL=http://localhost:5002
# Optional: file-service's address on a private network, preferred over FILE_SERVICE_URL for
# this service's own calls (e.g. http://file-service:5002 when the public URL goes through a proxy).
FILE_SERVICE_INTERNAL_URL=
FILE_SERVICE_API_KEY=<change-me>

# Must match auth-service: it calls /internal/* when issuing a project-limited API key.
INTERNAL_SERVICE_TOKEN=<change-me>
FILE_SERVICE_HMAC_SECRET=<change-me>

# Advertised to clients that reach vision-service through the MCP server.
MCP_PUBLIC_URL=http://localhost:5009
