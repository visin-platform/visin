{
  "extends": "./tsconfig.json",
  // ts-jest compiles tests to CommonJS with Bundler resolution; typecheck them the same way.
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
