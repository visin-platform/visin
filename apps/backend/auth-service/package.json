{
  "name": "auth-service",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin.git",
    "directory": "apps/backend/auth-service"
  },
  "author": "Toomas Tahves",
  "license": "MIT",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env -r ts-node/register\" src/index.ts",
    "build": "tsc",
    "recover:admin": "node --env-file-if-exists=.env dist/scripts/recoverAdmin.js",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:coverage": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "docs:generate": "UPDATE_OPENAPI_SCHEMAS=1 jest src/__tests__/openapi"
  },
  "dependencies": {
    "@visin/backend-core": "1.8.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "~9.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "11.3.0",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  }
}
