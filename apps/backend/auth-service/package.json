{
  "name": "auth-service",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin.git",
    "directory": "apps/backend/auth-service"
  },
  "author": "Toomas Tahves",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --watch --env-file-if-exists=.env -r ts-node/register src/index.ts",
    "build": "tsc",
    "recover:admin": "node --env-file-if-exists=.env dist/scripts/recoverAdmin.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "docs:generate": "UPDATE_OPENAPI_SCHEMAS=1 vitest run src/__tests__/openapi"
  },
  "dependencies": {
    "@visin/backend-core": "1.21.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "~9.10.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cookie-parser": "^1.4.7",
    "mongodb-memory-server": "11.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "oxlint": "^1.91.0",
    "vitest": "^5.1.0",
    "@vitest/coverage-istanbul": "^5.1.0"
  },
  "optionalDependencies": {
    "gcp-metadata": "^7.0.1"
  }
}
