PORT=5001
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/visin

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<change-me>

# Optional: leave blank for password-only sign-in.
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3004,http://localhost:3007,http://localhost:3012

COOKIE_DOMAIN=localhost

# Must match the value set in group-service
INTERNAL_SERVICE_TOKEN=<change-me>

GROUP_SERVICE_URL=http://localhost:5006

# Where to send someone who reaches the OAuth consent screen without a session.
AUTH_FRONT_URL=http://localhost:3004

# This service's own address, as a browser and a connecting assistant reach it.
# AUTH_SERVICE_PUBLIC_URL is the issuer named in the OAuth metadata, so it must
# be reachable from outside, not a container hostname.
AUTH_SERVICE_URL=http://localhost:5001
AUTH_SERVICE_PUBLIC_URL=http://localhost:5001

# The MCP endpoint resource tokens are bound to (RFC 8707).
MCP_PUBLIC_URL=http://localhost:5009

# Encrypts the recoverable copy of a user API key, so its owner can read it back
# after issuing it. OPTIONAL: leave blank and /auth/api-keys answers 501 while
# everything else works. Only the service that ISSUES keys needs it — verifying
# one runs off a SHA-256 digest and never touches the encrypted copy.
API_KEY_ENCRYPTION_SECRET=
