PORT=5001
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/visin

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<change-me>

# Optional: leave blank for password-only sign-in.
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3004,http://localhost:3007,http://localhost:3012

COOKIE_DOMAIN=localhost

# Must match the value set in group-service
INTERNAL_SERVICE_TOKEN=<change-me>

GROUP_SERVICE_URL=http://localhost:5006
