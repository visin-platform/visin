PORT=5012
SERVICE_NAME=chat-service
MONGODB_URI=mongodb://localhost:27017/visin
# Use the same values as the other local Visin services.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
API_KEY_ENCRYPTION_SECRET=
AUTH_SERVICE_URL=http://localhost:5001
GROUP_SERVICE_URL=http://localhost:5006
VISION_SERVICE_URL=http://localhost:4010
MCP_INTERNAL_URL=http://localhost:5009/mcp
CORS_ORIGIN=http://localhost:3010,http://localhost:3012,http://localhost:3014
# The analyst's switch, provider (anthropic or openai), model, daily token limit and provider keys are set by an
# administrator in Account > Analyst. Keys are stored encrypted with API_KEY_ENCRYPTION_SECRET; none is set here.

# Optional. Chat works without any of these.
# Notifications need nothing here: the signing keys are made on first start and kept in the database.
# Calls: with none of these set they connect on one local network. STUN_URLS (comma-separated) widens that to most
# home and mobile networks; a relay makes calls connect everywhere: your own coturn (TURN_URLS and TURN_SECRET, its
# static-auth-secret) or Cloudflare's hosted one (a key from the dashboard, under Realtime > TURN). First that is set
# and answers is used. CALLS_ENABLED=false turns calls off.
CALLS_ENABLED=true
STUN_URLS=
TURN_URLS=
TURN_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# File sharing is enabled by default. Use the same key as file-service and the other services that use it.
# The key is required at startup; local requests use port 5002 unless an internal URL overrides it.
FILE_SERVICE_URL=http://localhost:5002
FILE_SERVICE_API_KEY=

# Anonymous Vivi stays off until an administrator enables it with positive USD budgets.
# Trust only the direct proxy addresses/subnets that overwrite forwarded headers.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUEST_NETWORK_SECRET=
GUEST_TRUSTED_PROXY=
