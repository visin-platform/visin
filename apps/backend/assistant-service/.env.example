PORT=5018
SERVICE_NAME=assistant-service
MONGODB_URI=mongodb://localhost:27017/visin
# Use the same values as the other local Visin services.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
# Seals the provider keys an administrator saves; without it keys cannot be saved and Vivi stays unavailable.
API_KEY_ENCRYPTION_SECRET=
AUTH_SERVICE_URL=http://localhost:5001
GROUP_SERVICE_URL=http://localhost:5006
VISION_SERVICE_URL=http://localhost:4010
MCP_INTERNAL_URL=http://localhost:5009/mcp
CORS_ORIGIN=http://localhost:3010,http://localhost:3012,http://localhost:3014
# Chat is its own service: this one reads its collections and asks it, over its internal API, to change them.
CHAT_INTERNAL_URL=http://localhost:5012
# What this process is for is the program, not a setting: `dist/index.js` is the API (routes, the internal API chat
# calls, guest intake), `dist/index.worker.js` is Vivi's worker (answers signed-in and guest questions; serves only
# /health and /metrics) and `dist/index.all.js` is both in one process (`npm run dev` runs that). Deployed, run the first
# two in separate containers (see compose.yml) so a deploy of the API never interrupts an answer.
# How long a stopping worker lets running answers finish before aborting them, in milliseconds. Defaults to 265000 in
# production (a turn stops itself at 260s) and 5000 elsewhere. A container's stop grace period must be longer.
# WORKER_DRAIN_MS=
# The analyst's switch, provider (anthropic or openai), model, daily token limit and provider keys are set by an
# administrator in Account > Analyst. Keys are stored encrypted with API_KEY_ENCRYPTION_SECRET; none is set here.

# Pictures an assistant is shown are read from file-service. Use the same key as file-service.
FILE_SERVICE_URL=http://localhost:5002
FILE_SERVICE_API_KEY=
# Redis lets a worker find a new question at once, and several replicas wake each other. It works without it.
# REDIS_URL=redis://localhost:6379

# Anonymous Vivi stays off until an administrator enables it with positive USD budgets.
# Trust only the direct proxy addresses/subnets that overwrite forwarded headers.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUEST_NETWORK_SECRET=
GUEST_TRUSTED_PROXY=
