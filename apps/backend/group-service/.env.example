PORT=5006
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/visin

# Must match JWT_SECRET in auth-service
JWT_SECRET=<change-me>

# Must match INTERNAL_SERVICE_TOKEN in auth-service
INTERNAL_SERVICE_TOKEN=<change-me>

AUTH_SERVICE_URL=http://localhost:5001
# Asked what a group still owns before it is deleted for good
VISION_SERVICE_URL=http://localhost:4010
DATASET_SERVICE_URL=http://localhost:5010

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3004,http://localhost:3007,http://localhost:3010,http://localhost:3012
