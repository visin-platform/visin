{
  "name": "visin",
  "version": "0.0.97",
  "author": "Toomas Tahves",
  "license": "MIT",
  "workspaces": [
    "apps/frontend/*",
    "apps/backend/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\"",
    "dev:back": "concurrently \"npm run dev --workspace=file-service\" \"npm run dev --workspace=auth-service\" \"npm run dev --workspace=group-service\" \"npm run dev --workspace=vision-service\"",
    "dev:front": "concurrently \"npm run dev --workspace=auth-front\" \"npm run dev --workspace=vision-front\" \"npm run dev --workspace=landing-front\" \"npm run dev --workspace=account-front\"",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^8.29.0",
    "@tanstack/react-query": "^5.101.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "node-cron": "^4.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "stripe": "^22.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "~5.1.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "fs-extra": "^11.3.6",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
