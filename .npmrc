# Refuse to install on a Node version the workspaces don't declare support for
# (root package.json `engines.node`). Without this, `npm install` succeeds on an
# older runtime and the mismatch surfaces much later as unrelated-looking test
# failures — e.g. on Node 22, vision-front's useDatasetImageExport tests fail
# with "object.stream is not a function" from a jsdom/undici interop difference.
engine-strict=true
