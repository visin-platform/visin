# Environment variables for Docker Compose (do not commit this file)
#
# Every service asserts its required vars at startup (assertRequiredEnv in
# libs/backend-core) and exits if one is missing, so anything left blank below
# means that service won't boot.
#
# Backend
MONGODB_URI=mongodb://visin_admin:${MONGO_ROOT_PASSWORD}@mongodb:27017/visin
JWT_SECRET=
# Google sign-in audience — required by auth-service and auth-front.
GOOGLE_CLIENT_ID=
# Shared secret for the X-Internal-Token service-to-service header.
INTERNAL_SERVICE_TOKEN=

CORS_ORIGIN=http://localhost:3004,http://localhost:3007,http://localhost:3008,http://localhost:3012

# Service URLs. Each is used from two directions — service-to-service calls and
# the browser (every front's config.json is built from these) — so a deployed
# value must be publicly resolvable, not a Docker network hostname. The
# in-network defaults below only work for a stack with no browser callers.
AUTH_SERVICE_URL=http://auth-service:5001
GROUP_SERVICE_URL=http://group-service:5006

# Front URLs. The fronts share one navigation menu, so each needs the others'
# addresses to render the cross-app links (a missing one hides those entries).
VISION_FRONT_URL=https://app.visin.eu
ACCOUNT_FRONT_URL=https://account.visin.eu
LABEL_FRONT_URL=https://label.visin.eu

# Label Service
LABEL_SERVICE_URL=https://label-api.visin.eu
# Infra
CLOUDFLARE_API_TOKEN=

# File Service Configuration
FILE_SERVICE_URL=http://localhost:5002
FILE_SERVICE_API_KEY=
FILE_SERVICE_HMAC_SECRET=
FILE_SERVICE_DATA_DIR=/data

# MongoDB Configuration
MONGO_ROOT_PASSWORD=
MONGO_EXPRESS_PASSWORD=
