# Copy to .env beside the root compose.yml. Do not commit .env.
# This template is for the single-host stack; each app has its own .env.example
# for local development or a separate-service deployment.
#
# Blank values use the development defaults in compose.yml. Before exposing
# Visin on a network, set the secrets, NODE_ENV, PUBLIC_HOST, COOKIE_DOMAIN,
# CORS_ORIGIN and COMPOSE_BIND as described in README.md#production-deployment.

NODE_ENV=development
PUBLIC_HOST=http://localhost
COMPOSE_BIND=
COOKIE_DOMAIN=
CORS_ORIGIN=

# Root Compose starts its own MongoDB without authentication on an internal
# Docker network. This URI must match that instance. MongoDB and Redis host
# ports are bound to 127.0.0.1 by compose.yml.
MONGODB_URI=mongodb://mongodb:27017/visin
REDIS_URL=redis://redis:6379

# Set all four before network exposure; blank uses dev-only Compose defaults.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
FILE_SERVICE_API_KEY=
FILE_SERVICE_HMAC_SECRET=

# Optional. Blank disables user API key creation and Google sign-in.
API_KEY_ENCRYPTION_SECRET=
GOOGLE_CLIENT_ID=

# Optional image names. Root Compose builds locally from source.
REGISTRY=
TAG=

# Chat: human messaging works without an AI provider. An administrator switches the analyst on, and picks its
# provider (Anthropic or OpenAI), model, daily token limit and provider keys, in Account > Analyst; no key is set here.
CHAT_SERVICE_URL=http://localhost:5012
CHAT_FRONT_URL=http://localhost:3014
MCP_INTERNAL_URL=http://localhost:5009/mcp

# Chat notifications and calls need nothing here. Notifications sign themselves with keys the chat service makes on
# its first start (they need HTTPS, or localhost). Calls connect on one local network as they are:
#   - STUN widens that to most home and mobile networks. Compose defaults to Cloudflare's free public server, which
#     sees the callers' addresses; STUN_URLS= (set but empty) turns that off, or name your own: stun:host:3478
#   - a relay (TURN) makes calls connect everywhere. Either run your own (`docker compose --profile calls up -d`
#     with TURN_URLS and TURN_SECRET set, see compose.yml) or use Cloudflare's hosted relay (a free key from the
#     Cloudflare dashboard, under Realtime > TURN).
# CALLS_ENABLED=false hides the call buttons; chat is unaffected. Uncomment only what you set: a line left blank
# counts as set, and a blank STUN_URLS turns the default STUN server off.
# CALLS_ENABLED=
# STUN_URLS=
# TURN_URLS=
# TURN_SECRET=
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Guest Vivi (anonymous questions about public projects). Off until an administrator enables it in Admin, which
# refuses unless all four are set. Turnstile keys come from the Cloudflare dashboard (Turnstile > Add widget, with
# the hostnames that show guest Vivi). GUEST_NETWORK_SECRET: `openssl rand -hex 32`. GUEST_TRUSTED_PROXY lists the
# proxies trusted to report the visitor IP (Express `trust proxy`): `loopback` when browsers reach chat-service
# directly, the Docker network's subnet (e.g. 172.18.0.0/16) behind a reverse proxy. Never `true` or `uniquelocal`.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUEST_NETWORK_SECRET=
GUEST_TRUSTED_PROXY=

# Admin: the Grafana link in its header; blank hides it.
GRAFANA_URL=
