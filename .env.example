# Copy to .env beside the root compose.yml. Do not commit .env.
# This template is for the single-host stack; each app has its own .env.example
# for local development or a separate-service deployment.
#
# Blank values use the development defaults in compose.yml. Before exposing
# Visin on a network, set the secrets, NODE_ENV, PUBLIC_HOST, COOKIE_DOMAIN,
# CORS_ORIGIN and COMPOSE_BIND as described in README.md#production-deployment.

NODE_ENV=development
PUBLIC_HOST=http://localhost
COMPOSE_BIND=
COOKIE_DOMAIN=
CORS_ORIGIN=

# Root Compose starts its own MongoDB without authentication on an internal
# Docker network. This URI must match that instance. MongoDB and Redis host
# ports are bound to 127.0.0.1 by compose.yml.
MONGODB_URI=mongodb://mongodb:27017/visin
REDIS_URL=redis://redis:6379

# Set all four before network exposure; blank uses dev-only Compose defaults.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
FILE_SERVICE_API_KEY=
FILE_SERVICE_HMAC_SECRET=

# Optional. Blank disables user API key creation and Google sign-in.
API_KEY_ENCRYPTION_SECRET=
GOOGLE_CLIENT_ID=

# Optional image names. Root Compose builds locally from source.
REGISTRY=
TAG=
