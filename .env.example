# Environment variables for Docker Compose (do not commit this file)
#
# Every service asserts its required vars at startup (assertRequiredEnv in
# libs/backend-core) and exits if one is missing, so anything left blank below
# means that service won't boot.
#
# Container registry and tag the compose files pull from. Defaults keep the
# historical Docker Hub namespace, so leaving these unset behaves exactly as
# before; set REGISTRY to publish or pull from somewhere else, e.g.
# REGISTRY=ghcr.io/visin-platform. TAG pins a released version instead of :latest.
REGISTRY=
TAG=

# Backend
MONGODB_URI=mongodb://visin_admin:${MONGO_ROOT_PASSWORD}@mongodb:27017/visin
JWT_SECRET=
# Google sign-in audience. OPTIONAL: leave blank to run with email + password
# sign-in only, and the Google button disappears from the sign-in page.
GOOGLE_CLIENT_ID=
# Shared secret for the X-Internal-Token service-to-service header.
INTERNAL_SERVICE_TOKEN=
# Encrypts the recoverable copy of a user API key (`vsn_live_…`), so its owner
# can read a key back after issuing it. Needed only by the service that ISSUES
# keys — verification runs off a SHA-256 digest and never touches the encrypted
# copy, so a service that merely accepts keys works without this set. Keeping it
# out of the database is the whole point: a dump, a backup or a read-only
# replica is then not on its own enough to mint anyone's key.
API_KEY_ENCRYPTION_SECRET=

CORS_ORIGIN=http://localhost:3004,http://localhost:3007,http://localhost:3008,http://localhost:3012

# Service URLs. Each is used from two directions — service-to-service calls and
# the browser (every front's config.json is built from these) — so a deployed
# value must be publicly resolvable, not a Docker network hostname. The
# in-network defaults below only work for a stack with no browser callers.
AUTH_SERVICE_URL=http://auth-service:5001
GROUP_SERVICE_URL=http://group-service:5006
# Read by mcp-service, which forwards the caller's API key to vision-service on
# every tool call. VISION_INTERNAL_URL is the container-network shortcut and is
# preferred when set, so a tool call never leaves the host; VISION_SERVICE_URL
# is the required fallback.
VISION_SERVICE_URL=http://vision-service:4010
VISION_INTERNAL_URL=http://vision-service:4010

# MCP server. The canonical URL an assistant is told to connect and
# authenticate against — it ends up in the protected-resource metadata, so it
# must be the address clients actually reach, not a Docker hostname.
MCP_PUBLIC_URL=https://mcp.visin.eu

# Read by auth-service's OAuth flow: where to bounce someone who reaches the
# consent screen without a session, and the issuer named in the metadata a
# connecting assistant reads. Both must be addresses a browser can reach.
AUTH_FRONT_URL=https://auth.visin.eu
AUTH_SERVICE_PUBLIC_URL=https://auth-api.visin.eu

# Front URLs. The fronts share one navigation menu, so each needs the others'
# addresses to render the cross-app links (a missing one hides those entries).
VISION_FRONT_URL=https://app.visin.eu
ACCOUNT_FRONT_URL=https://account.visin.eu
LABEL_FRONT_URL=https://label.visin.eu

# Label Service
LABEL_SERVICE_URL=https://label-api.visin.eu
# Infra
# certbot's DNS-01 credential, used only by apps/infra/visin-proxy to issue and
# renew the wildcard certificate. Nothing else reads it — leave it blank unless
# you are running that proxy with Cloudflare-managed DNS.
CLOUDFLARE_API_TOKEN=

# File Service Configuration
FILE_SERVICE_URL=http://localhost:5002
FILE_SERVICE_API_KEY=
FILE_SERVICE_HMAC_SECRET=
FILE_SERVICE_DATA_DIR=/data

# MongoDB Configuration
MONGO_ROOT_PASSWORD=
MONGO_EXPRESS_PASSWORD=
