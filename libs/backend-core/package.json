{
  "name": "@visin/backend-core",
  "version": "1.21.0",
  "description": "Shared backend functionality for Visin services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi-testing": {
      "types": "./dist/openapi-testing/index.d.ts",
      "default": "./dist/openapi-testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin.git",
    "directory": "libs/backend-core"
  },
  "author": "Toomas Tahves",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "node ../../scripts/release.mjs --library && npm run build && npm publish --access public && node ../../scripts/sync-lib-versions.mjs",
    "release:beta": "node ../../scripts/release.mjs --library --prerelease beta && npm run build && npm publish --access public --tag beta",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "visin",
    "backend",
    "shared",
    "core",
    "microservices"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "~9.10.4",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "^5.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "oxlint": "^1.91.0",
    "vitest": "^5.1.0",
    "@vitest/coverage-istanbul": "^5.1.0"
  }
}
