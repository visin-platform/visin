{
  "name": "@visin/frontend-core",
  "version": "1.21.1",
  "description": "Shared frontend auth/API-client logic for Visin frontends",
  "author": "Toomas Tahves",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./federation": {
      "types": "./dist/federation.d.ts",
      "import": "./dist/federation.js",
      "default": "./dist/federation.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin.git",
    "directory": "libs/frontend-core"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "node ../../scripts/release.mjs --library && npm run build && npm publish --access public && node ../../scripts/sync-lib-versions.mjs",
    "release:beta": "node ../../scripts/release.mjs --library --prerelease beta && npm run build && npm publish --access public --tag beta",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "visin",
    "frontend",
    "shared",
    "auth",
    "api-client"
  ],
  "peerDependencies": {
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "react": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "oxlint": "^1.91.0"
  }
}
