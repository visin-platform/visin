{
  "name": "@visin/frontend-core",
  "version": "0.1.7",
  "description": "Shared frontend auth/API-client logic for Visin frontends",
  "author": "Toomas Tahves",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visin-platform/visin-monorepo.git",
    "directory": "libs/frontend-core"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "standard-version && npm run build && npm publish --access public",
    "release:beta": "standard-version --prerelease beta && npm run build && npm publish --access public --tag beta",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "visin",
    "frontend",
    "shared",
    "auth",
    "api-client"
  ],
  "peerDependencies": {
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
